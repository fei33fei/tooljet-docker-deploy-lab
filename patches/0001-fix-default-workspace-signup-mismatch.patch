+// Seeded workspaces need the same built-in sources as the normal onboarding flow.
+// This also repairs older seeds without replacing existing sources or options.
+async function ensureDefaultDataSources(manager: EntityManager, organizationId: string) {
+  const environments = await manager.find(AppEnvironment, { where: { organizationId } });
+  for (const kind of DefaultDataSourceKinds) {
+    let source = await manager.findOne(TooljetDataSource, {
+      where: { organizationId, kind, type: DataSourceTypes.STATIC },
+    });
+    if (!source) {
+      source = await manager.save(
+        manager.create(TooljetDataSource, {
+          name: kind + 'default',
+          kind,
+          organizationId,
+          type: DataSourceTypes.STATIC,
+          scope: DataSourceScopes.GLOBAL,
+        })
+      );
+    }
+    for (const environment of environments) {
+      const where = { dataSourceId: source.id, environmentId: environment.id };
+      if (!(await manager.findOne(DataSourceOptions, { where }))) {
+        await manager.save(manager.create(DataSourceOptions, where));
+      }
+    }
+  }
+}
