# ToolJet server 镜像 —— 本地开发变体（跳过 Oracle instantclient + npm 走国内镜像源）
#
# 与上游 docker/server.Dockerfile.dev 的差异有两处：
#
# 1) 移除下载 Oracle Instant Client 的那一层
#    上游要从 AWS S3 下载两个约 30MB 的 instantclient 包，本机实测速率仅约 44KB/s
#    （25 秒只下了 1.1MB），而这一层排在 npm install 之前，会把构建卡死。
#    instantclient 只服务于 oracledb 数据源插件的 thick 模式；该插件依赖的 npm 包
#    oracledb@^6 默认走 thin 模式，不依赖 instantclient。本项目研读不涉及 Oracle。
#
# 2) npm 安装改用国内镜像源
#    直连 registry.npmjs.org 拉后端依赖时出现过 `npm error network read ETIMEDOUT`。
#    实测同样 10 个 tarball：
#      registry.npmmirror.com  →  8.5 秒
#      registry.npmjs.org      →  44.4 秒   （慢 5.2 倍且会超时）
#    npm 默认的 replace-registry-host=npmjs 会把 lockfile 里 registry.npmjs.org
#    的 resolved 地址重写为配置的 registry，因此 lockfile 无需改动。
#
# 3) apt 换国内 Debian 镜像源
#    直连 deb.debian.org 实测只有 78KB/s（下载 8.7MB 的 Packages 索引要 100 秒以上），
#    国内镜像实测：
#      mirrors.ustc.edu.cn          → 1.40 MB/s
#      mirrors.tuna.tsinghua.edu.cn → 1.17 MB/s
#      deb.debian.org               → 0.08 MB/s   （慢 18 倍）
#
# 本文件未被 git 跟踪（已写入 .git/info/exclude），上游 tracked 文件保持原样。

FROM node:22.23.4-bookworm

# apt 换国内源（同时覆盖 sources.list 与 deb822 格式的 debian.sources）
RUN sed -i 's|deb.debian.org/debian-security|mirrors.ustc.edu.cn/debian-security|g; s|deb.debian.org/debian|mirrors.ustc.edu.cn/debian|g; s|security.debian.org/debian-security|mirrors.ustc.edu.cn/debian-security|g' \
      /etc/apt/sources.list 2>/dev/null; \
    sed -i 's|deb.debian.org/debian-security|mirrors.ustc.edu.cn/debian-security|g; s|deb.debian.org/debian|mirrors.ustc.edu.cn/debian|g; s|security.debian.org/debian-security|mirrors.ustc.edu.cn/debian-security|g' \
      /etc/apt/sources.list.d/debian.sources 2>/dev/null; \
    apt-get update && apt-get install -y --no-install-recommends \
      postgresql-client freetds-dev libaio1 libxml2 wget && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=development
ENV NODE_OPTIONS="--max-old-space-size=4096"

RUN npm i -g npm@10.9.9
RUN mkdir -p /app
WORKDIR /app

COPY ./package.json ./package.json

# install app dependencies
COPY ./server/package.json ./server/package-lock.json ./server/
RUN npm --prefix server install \
      --registry=https://registry.npmmirror.com \
      --replace-registry-host=npmjs \
      --no-audit --no-fund \
      --fetch-retries=5 \
      --fetch-retry-mintimeout=20000 \
      --fetch-retry-maxtimeout=120000
COPY ./server/ ./server/

COPY ./docker/dev-entrypoint.sh ./server/dev-entrypoint.sh
RUN chmod +x ./server/dev-entrypoint.sh

ENTRYPOINT ["./server/dev-entrypoint.sh"]
